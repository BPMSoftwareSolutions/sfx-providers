<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>SfxProviders.CliLogin</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="live-tests/**/*.cs" />
    <Compile Include="../cli-login-input-provider/*.cs" />
    <Compile Include="../identity-principal-provider/*.cs" />
    <Compile Include="../password-credential-provider/*.cs" />
    <Compile Include="../ide-session-provider/*.cs" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <ProjectReference Include="../../../sfx-dal/identity/SFX.Identity.DAL.csproj" />
  </ItemGroup>
</Project>
